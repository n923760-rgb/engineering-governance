{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Result Packet",
  "type": "object",
  "required": [
    "task_id",
    "task_type",
    "task_packet_ref",
    "executor",
    "execution_environment",
    "repository",
    "official_branch",
    "verified_remote_official_head",
    "exact_tested_head",
    "authorized_actions",
    "actions_actually_performed",
    "validation",
    "facts",
    "inferences",
    "assumptions",
    "residual_risks",
    "recommended_next_action",
    "task_packet_sha256"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_packet_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "executor": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "execution_environment": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "official_branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verified_remote_official_head": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "exact_tested_head": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "authorized_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "uniqueItems": true
    },
    "actions_actually_performed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check",
          "status",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNKNOWN",
              "SKIPPED",
              "NOT RUN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_manifest_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "additionalProperties": true
}
