{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adopted Governance Source",
  "type": "object",
  "required": [
    "format_version",
    "status",
    "source_repository",
    "source_commit_sha",
    "observed_git_head_sha",
    "source_worktree_dirty",
    "governance_version",
    "recorded_at",
    "risk_profile",
    "files"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "status": {
      "const": "DRAFT_LIVE_VERIFICATION_REQUIRED"
    },
    "source_repository": {
      "const": "https://github.com/n923760-rgb/engineering-governance"
    },
    "source_commit_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "observed_git_head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "source_worktree_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "governance_version": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "risk_profile": {
      "enum": [
        "LIGHT",
        "STANDARD",
        "HIGH"
      ]
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
