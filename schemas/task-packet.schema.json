{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Task Packet",
  "type": "object",
  "required": ["title", "task_type", "authority", "repository", "official_branch", "expected_official_head", "scope", "out_of_scope", "task", "validation", "stop_conditions", "success_criteria"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["READ-ONLY DIAGNOSIS", "IMPLEMENTATION", "RUNTIME QUALIFICATION", "CI INVESTIGATION", "INFRASTRUCTURE MAINTENANCE"]},
    "authority": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "official_branch": {"type": "string", "minLength": 1},
    "expected_official_head": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "existing_pr": {},
    "expected_pr_head": {},
    "scope": {"type": "string", "minLength": 1},
    "out_of_scope": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "validation": {"type": "string", "minLength": 1},
    "artifacts": {},
    "stop_conditions": {"type": "string", "minLength": 1},
    "report_path": {"type": ["string", "null"]},
    "success_criteria": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
