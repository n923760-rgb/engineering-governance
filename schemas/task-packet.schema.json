{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Task Packet",
  "type": "object",
  "required": [
    "title",
    "task_type",
    "authority",
    "repository",
    "official_branch",
    "expected_official_head",
    "scope",
    "out_of_scope",
    "task",
    "validation",
    "stop_conditions",
    "success_criteria",
    "requested_actions",
    "authorized_actions",
    "protected_actions",
    "protected_action_authorizations",
    "task_id"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task_type": {
      "enum": [
        "READ-ONLY DIAGNOSIS",
        "IMPLEMENTATION",
        "RUNTIME QUALIFICATION",
        "CI INVESTIGATION",
        "INFRASTRUCTURE MAINTENANCE"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "official_branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "expected_official_head": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "existing_pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "expected_pr_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "out_of_scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "validation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifacts": {},
    "stop_conditions": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "report_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "success_criteria": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "requested_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "uniqueItems": true
    },
    "authorized_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "uniqueItems": true
    },
    "protected_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "uniqueItems": true
    },
    "protected_action_authorizations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source",
          "reference",
          "authorization_id",
          "status",
          "repository",
          "target",
          "boundary"
        ],
        "properties": {
          "source": {
            "enum": [
              "CURRENT_OWNER_INSTRUCTION",
              "OWNER_AUTHORIZATION_RECORD"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authorization_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "REVOKED"
            ]
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expires_at": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "expected_pr_base": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "action_targets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "risk_profile": {
      "enum": [
        "LIGHT",
        "STANDARD",
        "HIGH"
      ]
    }
  },
  "additionalProperties": true
}
